# bash completion for llmctx
# generated by king (https://github.com/miekg/king) for kong

_llmctx_filter() {
  COMP_REPLY=()
  local words="$1"
  local cur=${COMP_WORDS[COMP_CWORD]}
  local result=()

  if [[ "${cur:0:1}" == "-" ]]; then
    echo "$words"

  else
    for word in $words; do
      [[ "${word:0:1}" != "-" ]] && result+=("$word")
    done
    echo "${result[*]}"
  fi
}

_llmctx_context_names() {
  # Names of stashed contexts from `llmctx list --porcelain` (name\0desc\0...).
  local name desc
  while read -r -d '' name && read -r -d '' desc; do
    printf '%s\n' "$name"
  done < <(llmctx list --porcelain)
}

_llmctx_completions() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local compwords=("${COMP_WORDS[@]:1:$COMP_CWORD-1}")
  local compline="${compwords[*]}"

  case "$compline" in

    'completion'*)
      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "bash zsh fish" -- "$cur")
      ;;
    'delete'*)
      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(_llmctx_context_names)" -- "$cur")
      ;;
    'apply'*)
      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(_llmctx_context_names)" -- "$cur")
      ;;
    'stash'*)
      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(_llmctx_filter "--name -n --description -d ")" -- "$cur")
      ;;
    'edit'*)
      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(_llmctx_context_names)" -- "$cur")
      ;;
    'info'*)
      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(_llmctx_context_names)" -- "$cur")
      ;;
    'list'*)
      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(_llmctx_filter "")" -- "$cur")
      ;;

    *)
      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(_llmctx_filter "apply delete edit info list stash completion --help -h")" -- "$cur")
      ;;
esac

} &&
complete -F _llmctx_completions llmctx

