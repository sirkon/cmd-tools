#compdef llmctx
compdef _llmctx llmctx
# zsh completion for llmctx
# generated by king (https://github.com/miekg/king) for kong

_llmctx_context_items() {
    # Names and descriptions of stashed contexts from `llmctx list --porcelain`
    # (name\0desc\0...). Shown as aligned "name -- description" items.
    local -a items
    local name desc
    while IFS= read -r -d '' name && IFS= read -r -d '' desc; do
        items+=("$name:$desc")
    done < <(llmctx list --porcelain)
    _describe 'context' items
}

_llmctx_apply() {
    _arguments -S -C -s\
 \
        "1:name:_llmctx_context_items" \
        "2:file:_files"
}

_llmctx_delete() {
    _arguments -S -C -s\
 \
        "1:name:_llmctx_context_items"
}

_llmctx_edit() {
    _arguments -S -C -s\
 \
        "1:name:_llmctx_context_items"
}

_llmctx_info() {
    _arguments -S -C -s\
 \
        "1:name:_llmctx_context_items"
}

_llmctx_list() {
    _arguments -S -C -s\

}

_llmctx_stash_file() {
    # Suggest the required -n/--name and -d/--description flags until both have
    # been given, then fall back to completing the context file path.
    local n=no d=no w
    for w in "${words[@]}"; do
        case "$w" in
            -n|--name|--name=*) n=yes ;;
            -d|--description|--description=*) d=yes ;;
        esac
    done
    if [[ $n == no || $d == no ]]; then
        compadd -- '-n' '--name' '-d' '--description'
        return
    fi
    _files
}

_llmctx_stash() {
    _arguments -S -C -s\
        '(-n --name=)'{-n,--name=}"[Name to stash context under.]:name to stash context under.:" \
        '(-d --description=)'{-d,--description=}"[Description of context.]:description of context.:" \
        ":file:_llmctx_stash_file"
}

_llmctx_shells() {
    local -a items=(
        'bash:Completion script for Bash.'
        'zsh:Completion script for Zsh.'
        'fish:Completion script for Fish.'
    )
    _describe 'shell' items
}

_llmctx_completion() {
    _arguments -S -C -s\
        "1:shell:_llmctx_shells"
}

_llmctx() {
    local line state
    _arguments -S -C -s\
        '(-h --help)'{-h,--help}"[Show context-sensitive help.]" \
        "1: :->cmds" \
        "*::arg:->args"
    case "$state" in
        cmds)
            _values "llmctx command" \
                "apply[Add given context into the current project.]" \
                "delete[Delete given context.]" \
                "edit[Edit text of the given context.]" \
                "info[Show context information.]" \
                "list[List all contexts.]" \
                "stash[Stash context.]" \
                "completion[Generate completion code.]"
            ;;
        args)
            case "$line[1]" in
                apply)
                    _llmctx_apply;;
                delete)
                    _llmctx_delete;;
                edit)
                    _llmctx_edit;;
                info)
                    _llmctx_info;;
                list)
                    _llmctx_list;;
                stash)
                    _llmctx_stash;;
                completion)
                    _llmctx_completion;;
            esac
            ;;
    esac

}


